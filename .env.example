# Copy this file to .env and paste your real key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# --- HTTP server (npm run serve) ---
# Port the API listens on (Render sets PORT automatically; local default 8787).
# PORT=8787
# The widget origin allowed by CORS. Local dev default is the Vite dev server.
# In production set this to your Vercel URL, e.g. https://quoteagent.vercel.app
# WIDGET_ORIGIN=http://localhost:5173

# --- Optional model overrides (defaults shown) ---
# New free-tier keys have no quota for gemini-2.0-flash, which is why the
# default agent model is gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_JUDGE_MODEL=gemini-2.5-flash-lite

# --- Optional provider switch (default: gemini) ---
# Gemini's free tier is only ~20 requests/day. Groq's free tier is far more
# generous, so you can run bulk evals on Groq and keep Gemini for real chats.
# Set LLM_PROVIDER=groq and add a free key from https://console.groq.com/keys
# LLM_PROVIDER=gemini
# GROQ_API_KEY=your-groq-key-here
# GROQ_MODEL=llama-3.3-70b-versatile
