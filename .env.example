# Copy this file to .env and paste your real key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional overrides (defaults shown). New free-tier keys have no quota for
# gemini-2.0-flash, which is why the default agent model is gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_JUDGE_MODEL=gemini-2.5-flash-lite
